# No real credentials in this file. Copy locally to .env only when access is available.
NEBIUS_API_KEY=
NEBIUS_MODEL=
# Missing/zero cap disables inference. Requires explicit human authorization.
NEBIUS_CAP_USD=0
NEBIUS_INPUT_USD_PER_MILLION=
NEBIUS_OUTPUT_USD_PER_MILLION=
# Required conservative bound on all prompt tokens,including provider framing.
NEBIUS_MAX_INPUT_TOKENS=
NEBIUS_ACCESS_CONFIRMED=false
PORT=4317
# Lead must verify complete selected-model billable-token bounds before enabling.
NEBIUS_BILLING_BOUNDS_CONFIRMED=false
